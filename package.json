{
  "name": "d-d-character-randomizer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run typecheck && esbuild src/module.ts --bundle --format=esm --target=es2022 --outfile=dist/module.js",
    "generate:pdf-template": "node scripts/generate-pdf-template.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "esbuild": "^0.28.2",
    "typescript": "^5.8.3",
    "vitest": "^5.0.5"
  }
}
